# PGPM's settings for deploy/docker-compose.yml: copy to .env (0600) and fill in. ASP.NET names (Section__Key) reach the
# app as they are (docs/03 §14); only what differs from the defaults needs a line.

# --- compose ---------------------------------------------------------------------------------------------------------
# The database's password: set once, before the first start (e.g. `openssl rand -hex 16`), then never changed here.
PGPM_DB_PASSWORD=
# PGPM_IMAGE=uisach/pgpm
# PGPM_IMAGE_TAG=v0.1.0
# PGPM_BIND_ADDRESS=127.0.0.1
# PGPM_PORT=7330
# PGPM_FILES_DIR=./files

# --- the app ---------------------------------------------------------------------------------------------------------
# The address users open (the reverse proxy's): the SSO redirect URI and the live channel's WebSocket origin.
PublicUrl=https://pgpm.example.com
# The reverse proxies whose X-Forwarded-For/-Proto are trusted: docker, addresses, networks (comma-separated).
# Proxy=docker
# The zone for wall-clock rules (IANA name).
TZ=Europe/Zurich

# The first admin, created while the database has no users (from phase 1): must be changed at the first sign-in.
Auth__InitialAdmin__Username=admin
Auth__InitialAdmin__Password=

# Microsoft SSO and the directory sync (one Entra app registration, docs/03 §5.5): from phase 1 and phase 6.
# Entra__Enabled=false
# Entra__TenantId=
# Entra__ClientId=
# Entra__ClientSecret=
# Directory__Enabled=false
