# PGPM's settings for deploy/docker-compose.yml. ./init.sh writes .env (0600) from this file with generated secrets;
# by hand: copy it to .env and fill in PGPM_DB_PASSWORD, Auth__InitialAdmin__Password and PublicUrl. ASP.NET names
# (Section__Key) reach the app as they are (docs/admin-guide.md, "Configuration keys"); only what differs from the
# defaults needs a line. After a change: docker compose up -d.

# --- compose ---------------------------------------------------------------------------------------------------------
# The database's password: set once, before the first start, then never changed here (the database keeps it).
PGPM_DB_PASSWORD=
# The image and its release; ./update.sh --tag v1.0.1 changes the tag.
# PGPM_IMAGE=uisach/pgpm
# PGPM_IMAGE_TAG=v1.0.0
# Where the app is published on this host: 127.0.0.1 for a reverse proxy here, 0.0.0.0 for one elsewhere.
# PGPM_BIND_ADDRESS=127.0.0.1
# PGPM_PORT=7330
# The attachments' folder on this host (owned by uid 1654, 0750; ./init.sh creates it).
# PGPM_FILES_DIR=./files
# Where ./backup.sh writes, and how many backups it keeps (all, without a number).
# PGPM_BACKUP_DIR=backups
# PGPM_BACKUP_KEEP=14
# Another project name runs a second stack from a copy of this folder (volumes are <project>_pgpm-…).
# COMPOSE_PROJECT_NAME=pgpm

# --- the app ---------------------------------------------------------------------------------------------------------
# The address users open (the reverse proxy's, https): the SSO redirect URI base and the live channel's WebSocket origin.
PublicUrl=https://pgpm.example.com
# The reverse proxies whose X-Forwarded-For/-Proto are trusted: docker, addresses, networks (comma-separated). Behind a
# proxy on this host: docker.
# Proxy=docker
# The zone for wall-clock rules such as Auth__ResetHour (IANA name).
TZ=Europe/Zurich

# The first admin, created while the database has no users: must be changed at the first sign-in. Without a password a
# random one is generated and logged once (docker compose logs pgpm).
Auth__InitialAdmin__Username=admin
Auth__InitialAdmin__Password=
# Optional | RequiredForAdmins | Required
# Auth__TotpPolicy=Optional
# Where local (password) sign-in is allowed: all, none (Microsoft only, needs Entra__Enabled), or networks/addresses.
# Auth__LocalLoginNetworks=all

# --- Microsoft SSO and directory sync (optional) ---------------------------------------------------------------------
# One Entra app registration for both (docs/admin-guide.md, "Microsoft Entra"): redirect URI PublicUrl + /signin-oidc,
# delegated User.Read for the sign-in, application User.Read.All (admin consent) for the directory.
# Entra__Enabled=true
# Entra__TenantId=00000000-0000-0000-0000-000000000000
# Entra__ClientId=00000000-0000-0000-0000-000000000000
# Entra__ClientSecret=
# Entra__AutoProvision=true
# Entra__DefaultGroupId=
# Directory__Enabled=true
# Directory__IntervalHours=6
# Directory__FullSyncDays=7

# --- MCP (assistants) ----------------------------------------------------------------------------------------------
# On by default: users switch their own tokens on (Account → Security → MCP). false removes /mcp.
# Mcp__Enabled=true
# Mcp__WriteHours=12
