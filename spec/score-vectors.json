        {
          "key": "s_ok",
          "type": "select",
          "config": { "options": [{ "id": "a", "label": "A", "points": 1 }, { "id": "old", "label": "Old", "archived": true }] }
        },
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["s1", "m1", "m2", "s_ok"] } }
      ],
      "score": "x",
      "expectErrors": [
        { "code": "options_without_points", "input": "s1" },
        { "code": "options_without_points", "input": "m2" }
      ]
    },
    {
      "name": "a score that is its own input",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1", "x"] } }],
      "score": "x",
      "expectErrors": [{ "code": "cycle", "input": "x" }]
    },
    {
      "name": "a cycle through another score",
      "use": ["basic"],
      "fields": [
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["y", "n1"] } },
        { "key": "y", "type": "score", "config": { "op": "sum", "inputs": ["n2", "x"] } }
      ],
      "score": "x",
      "expectErrors": [{ "code": "cycle", "input": "y" }]
    },
    {
      "name": "a cycle further down that x can't be evaluated through",
      "use": ["basic"],
      "fields": [
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1", "y"] } },
        { "key": "y", "type": "score", "config": { "op": "sum", "inputs": ["z"] } },
        { "key": "z", "type": "score", "config": { "op": "sum", "inputs": ["y"] } }
      ],
      "score": "x",
      "expectErrors": [{ "code": "cycle", "input": "y" }]
    },
    {
      "name": "scores sharing an input are no cycle",
      "use": ["basic"],
      "fields": [
        { "key": "a", "type": "score", "config": { "op": "sum", "inputs": ["n1"] } },
        { "key": "b", "type": "score", "config": { "op": "sum", "inputs": ["a", "n1"] } },
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["a", "b"] } }
      ],
      "score": "x",
      "expectErrors": []
    },
    {
      "name": "rescale (sum) and normalize need a max above 0",
      "use": ["basic"],
      "fields": [
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["r1"], "na": "rescale" } },
        { "key": "y", "type": "score", "config": { "op": "avg", "inputs": ["r1"], "normalize": true, "max": 0 } }
      ],
      "score": "x",
      "expectErrors": [{ "code": "max_required" }]
    },
    {
      "name": "normalize with a max of 0",
      "use": ["basic"],
      "fields": [{ "key": "y", "type": "score", "config": { "op": "avg", "inputs": ["r1"], "normalize": true, "max": 0 } }],
      "score": "y",
      "expectErrors": [{ "code": "max_required" }]
    },
    {
      "name": "rescale with neither max: reported once",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["r1"], "na": "rescale", "normalize": true } }],
      "score": "x",
      "expectErrors": [{ "code": "max_required" }]
    },
    {
      "name": "rescale (sum) needs every input's maximum: a number without max, a score without max",
      "use": ["basic"],
      "fields": [
        { "key": "inner", "type": "score", "config": { "op": "sum", "inputs": ["n1"] } },
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n_nomax", "inner", "r_default", "s_ok", "m1"], "na": "rescale", "max": 50 } },
        { "key": "s_ok", "type": "select", "config": { "options": [{ "id": "a", "label": "A", "points": 1 }] } }
      ],
      "score": "x",
      "expectErrors": [
        { "code": "input_max_required", "input": "n_nomax" },
        { "code": "input_max_required", "input": "inner" }
      ]
    },
    {
      "name": "a cap supplies a number's maximum; a normalised score has one",
      "use": ["basic"],
      "fields": [
        { "key": "inner", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "max": 10, "normalize": true } },
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n_nomax", "inner"], "cap": { "n_nomax": 100 }, "na": "rescale", "max": 50 } }
      ],
      "score": "x",
      "expectErrors": []
    },
    {
      "name": "rescale with another op than sum needs no maxima (it works like ignore)",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "avg", "inputs": ["n_nomax", "r1"], "na": "rescale" } }],
      "score": "x",
      "expectErrors": []
    },
    {
      "name": "a cap on a key that isn't an input",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "cap": { "n2": 5, "n1": 3 } } }],
      "score": "x",
      "expectErrors": [{ "code": "invalid_cap", "input": "n2" }]
    },
    {
      "name": "decimals must be a whole number from 0 to 10",
      "use": ["basic"],
      "fields": [
        { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "decimals": 11 } },
        { "key": "y", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "decimals": -1 } },
        { "key": "z", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "decimals": 1.5 } }
      ],
      "score": "x",
      "expectErrors": [{ "code": "invalid_decimals" }]
    },
    {
      "name": "negative decimals",
      "use": ["basic"],
      "fields": [{ "key": "y", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "decimals": -1 } }],
      "score": "y",
      "expectErrors": [{ "code": "invalid_decimals" }]
    },
    {
      "name": "fractional decimals",
      "use": ["basic"],
      "fields": [{ "key": "z", "type": "score", "config": { "op": "sum", "inputs": ["n1"], "decimals": 1.5 } }],
      "score": "z",
      "expectErrors": [{ "code": "invalid_decimals" }]
    },
    {
      "name": "the definition being saved replaces the stored one of the same key",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["x"] } }],
      "score": "x",
      "replace": { "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1"] } },
      "expectErrors": []
    }
  ]
}
