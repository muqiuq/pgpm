      "values": {
        "feas_data_access": 5, "feas_infra": 5, "feas_data_quality": 5,
        "feas_problem_known": 5, "feas_similar_solution": 5, "feas_tech_known": 5,
        "feas_no_new_processes": 5, "feas_processes_adaptable": 5, "feas_no_changes": 5,
