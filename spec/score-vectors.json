{
  "$comment": [
    "Score evaluation (docs/03 §16): the test vectors both implementations run against.",
    "TypeScript: PGPM.WebUI/src/domain/score.test.ts. C#: PGPM.Tests/Config/ScoreEvaluatorTests.cs.",
    "A case's fields are its fieldSets (in the order of 'use'), then its own 'fields'; a later definition with the same key",
    "replaces an earlier one. 'expect' names score keys and their results (null: incomplete or not evaluable),",
    "'expectMax' what scoreMax() gives. A validation case validates 'score' against all the case's fields and expects",
    "exactly the errors listed (in any order)."
  ],
  "fieldSets": {
    "feasibility": [
      { "key": "feas_data_access", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_infra", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_data_quality", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_problem_known", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_similar_solution", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_tech_known", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_no_new_processes", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_processes_adaptable", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_no_changes", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_tech_knowhow", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_domain_knowhow", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "feas_ai_understanding", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      {
        "key": "time_to_proof_of_value",
        "type": "select",
        "config": {
          "options": [
            { "id": "lt3", "label": "< 3 months", "points": 5 },
            { "id": "m4_6", "label": "4–6 months", "points": 4 },
            { "id": "m7_9", "label": "7–9 months", "points": 3 },
            { "id": "m10_12", "label": "10–12 months", "points": 2 },
            { "id": "gt12", "label": "> 12 months", "points": 1 }
          ]
        }
      },
      {
        "key": "feasibility_index",
        "type": "score",
        "config": {
          "op": "sum",
          "inputs": [
            "feas_data_access", "feas_infra", "feas_data_quality",
            "feas_problem_known", "feas_similar_solution", "feas_tech_known",
            "feas_no_new_processes", "feas_processes_adaptable", "feas_no_changes",
            "feas_tech_knowhow", "feas_domain_knowhow", "feas_ai_understanding",
            "time_to_proof_of_value"
          ],
          "na": "rescale",
          "max": 65,
          "decimals": 0
        }
      }
    ],
    "impact": [
      { "key": "impact_reach", "type": "rating", "config": { "min": 0, "max": 5 } },
      { "key": "impact_strategic", "type": "rating", "config": { "min": 0, "max": 5 } },
      {
        "key": "impact_value_band",
        "type": "select",
        "config": {
          "options": [
            { "id": "lt10k", "label": "< 10k", "points": 1 },
            { "id": "k10_50", "label": "10–50k", "points": 2 },
            { "id": "k50_200", "label": "50–200k", "points": 3 },
            { "id": "k200_1m", "label": "200k–1M", "points": 4 },
            { "id": "gt1m", "label": "> 1M", "points": 5 }
          ]
        }
      },
      {
        "key": "strategic_advantages",
        "type": "multiselect",
        "config": {
          "multiPoints": "count",
          "options": [
            { "id": "customer_experience", "label": "Better customer experience" },
            { "id": "revenue_growth", "label": "Revenue growth" },
            { "id": "higher_sales", "label": "Higher sales" },
            { "id": "less_complexity", "label": "Reduced complexity / risk" },
            { "id": "efficiency", "label": "Responsiveness / efficiency" },
            { "id": "quality", "label": "Quality of service or product" },
            { "id": "new_market", "label": "New market" },
            { "id": "insights", "label": "Better decisions through insights" }
          ]
        }
      },
      {
        "key": "impact_score",
        "type": "score",
        "config": {
          "op": "sum",
          "inputs": ["impact_reach", "impact_strategic", "impact_value_band", "strategic_advantages"],
          "cap": { "strategic_advantages": 5 },
          "na": "rescale",
          "max": 20,
          "normalize": true,
          "decimals": 0
        }
      }
    ],
    "basic": [
      { "key": "n1", "type": "number", "config": { "decimals": 2, "min": null, "max": 10 } },
      { "key": "n2", "type": "number", "config": { "max": 10 } },
      { "key": "n3", "type": "number", "config": { "max": 10 } },
      { "key": "n4", "type": "number", "config": { "max": 10 } },
      { "key": "n_nomax", "type": "number", "config": { "unit": "CHF" } },
      { "key": "r1", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "r2", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "r3", "type": "rating", "config": { "min": 0, "max": 5, "allowNa": true } },
      { "key": "r_default", "type": "rating", "config": { "allowNa": true } },
      {
        "key": "s1",
        "type": "select",
        "config": {
          "options": [
            { "id": "a", "label": "A", "points": 1 },
            { "id": "b", "label": "B", "points": 3 },
            { "id": "c", "label": "C (no points)" }
          ]
        }
      },
      {
        "key": "m1",
        "type": "multiselect",
        "config": {
          "multiPoints": "count",
          "options": [
            { "id": "o1", "label": "O1", "points": 2 },
            { "id": "o2", "label": "O2", "points": 5 },
            { "id": "o3", "label": "O3", "points": 1 },
            { "id": "o4", "label": "O4 (no points)" }
          ]
        }
      },
      {
        "key": "m2",
        "type": "multiselect",
        "config": {
          "multiPoints": "sum",
          "options": [
            { "id": "o1", "label": "O1", "points": 2 },
            { "id": "o2", "label": "O2", "points": 5 },
            { "id": "o3", "label": "O3", "points": 1 },
            { "id": "o4", "label": "O4 (no points)" }
          ]
        }
      },
      {
        "key": "m3",
        "type": "multiselect",
        "config": {
          "multiPoints": "sum",
          "options": [
            { "id": "p1", "label": "P1", "points": 2 },
            { "id": "p2", "label": "P2", "points": 3, "archived": true }
          ]
        }
      },
      { "key": "m_default", "type": "multiselect", "config": { "options": [{ "id": "x", "label": "X" }, { "id": "y", "label": "Y" }] } },
      { "key": "t1", "type": "text", "config": { "maxLength": 200 } },
      { "key": "b1", "type": "bool", "config": {} },
      { "key": "d1", "type": "date", "config": { "timebox": true } }
    ]
  },
  "cases": [
    {
      "name": "feasibility index: the playbook's ratings (p. 34) and < 3 months give 53 + 5 = 58",
