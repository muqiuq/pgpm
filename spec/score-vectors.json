    },
    {
      "name": "op sum (decimals 0): 6.5 rounds away from zero to 7",
      "use": ["basic"],
      "fields": [{ "key": "x", "type": "score", "config": { "op": "sum", "inputs": ["n1", "n2", "n3", "n4"], "decimals": 0 } }],
