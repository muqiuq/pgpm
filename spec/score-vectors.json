      "values": {
        "feas_data_access": 5, "feas_infra": 4, "feas_data_quality": 4,
        "feas_problem_known": 5, "feas_similar_solution": 4, "feas_tech_known": 5,
        "feas_no_new_processes": 5, "feas_processes_adaptable": 4, "feas_no_changes": 4,
        "feas_tech_knowhow": 4, "feas_domain_knowhow": 5, "feas_ai_understanding": 4,
        "time_to_proof_of_value": "lt3"
      },
      "expect": { "feasibility_index": 58 },
      "expectMax": { "feasibility_index": 65 }
    },
    {
      "name": "feasibility index, rescale: two ratings n/a, a raw 48 becomes 48 × 65/55 = 56.7 → 57",
      "use": ["feasibility"],
      "values": {
